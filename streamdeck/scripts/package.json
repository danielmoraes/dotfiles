{
  "name": "streamdeck-scripts",
  "version": "0.1.0",
  "description": "macOS glue commands invoked by Stream Deck keys (switch account, summon agents, focus/meeting mode, quick capture, standup)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "typecheck": "tsc --noEmit",
    "test": "vp test --run"
  },
  "dependencies": {
    "streamdeck-secrets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
