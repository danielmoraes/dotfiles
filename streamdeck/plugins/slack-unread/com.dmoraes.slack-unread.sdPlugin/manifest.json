{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Slack",
  "Version": "0.1.0.0",
  "Author": "Daniel Moraes",
  "UUID": "com.dmoraes.slack-unread",
  "Description": "Unread count and current status, from the desktop app and the Slack API.",
  "Category": "Slack",
  "CategoryIcon": "imgs/plugin/category",
  "Icon": "imgs/plugin/icon",
  "URL": "https://github.com/danielmoraes/dotfiles",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "6.9"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "CodePath": "bin/plugin.js",
  "Actions": [
    {
      "Name": "Unread Count",
      "UUID": "com.dmoraes.slack-unread.unread-count",
      "Icon": "imgs/actions/unread-count/icon",
      "Tooltip": "Show unread Slack mentions/DMs. Press to open Slack.",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/actions/unread-count/key",
          "TitleAlignment": "middle"
        },
        {
          "Image": "imgs/actions/unread-count/key-alert",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Slack Status",
      "UUID": "com.dmoraes.slack-unread.status",
      "Icon": "imgs/actions/status/icon",
      "Tooltip": "Show your Slack status; press to cycle online / focusing / away.",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/status/key",
          "TitleAlignment": "middle"
        }
      ]
    }
  ]
}
